# QPKG 安装/升级/卸载钩子(由 qinstall.sh source;卸载三钩为字符串代码块,
# 被嵌入生成的 .uninstall.sh 执行,引用不到本文件变量——但本文件顶层的
# 变量在 source 时即展开为字面量,故卸载钩里见到的已是具体路径)。
#
# QDK 打包布局:shared/ 内容被 rsync 平铺到包根(rsync shared/. → build 根),
# env.example 安装后位于 ${SYS_QPKG_DIR}/env.example(勿加 shared/ 前缀——
# 旧版 Docker 包曾因该路径错觉引用 ${SYS_QPKG_DIR}/shared/env.example,真机必挂)。

# FCB_GETCFG/FCB_WRITE_LOG 仅供测试注入 mock(QTS 的 qinstall 运行环境不会设置)
GETCFG="${FCB_GETCFG:-/sbin/getcfg}"
WRITE_LOG="${FCB_WRITE_LOG:-/sbin/write_log}"
DEF_SHARE="${FCB_DEF_SHARE_INFO:-/etc/config/def_share.info}"

pkg_pre_install() {
    # 装完即启:qinstall.sh 按此变量决定安装完成后是否调用服务脚本 start
    SYS_QPKG_SERVICE_ENABLED="TRUE"
}

pkg_post_install() {
    # 构建机 uid 残留防护:QTS 以 root 执行服务脚本与二进制,包内文件统一归零
    # (构建 uid 若属 NAS 真实用户,可改写 root 执行的脚本,提权风险)。
    # 尽力而为:非 root 环境(本地/CI mock 测试)静默跳过;真机 qinstall 以 root 执行必成。
    chown -R 0:0 "${SYS_QPKG_DIR}" 2>/dev/null || true

    _base=$("$GETCFG" SHARE_DEF defVolMP -f "$DEF_SHARE" 2>/dev/null)
    [ -n "$_base" ] || _base="/share/CACHEDEV1_DATA"
    _appdir="${_base}/pigeonbox"
    # 业务数据(SQLite 库/上传文件/JWT 密钥)在卷根,卸载升级均保留
    mkdir -p "${_appdir}/data"

    _env="${_appdir}/.env"
    if [ ! -f "$_env" ]; then
        {
            grep -vE '^PB_SERVER_PORT=' "${SYS_QPKG_DIR}/env.example"
            printf 'PB_SERVER_PORT=%s\n' "12345"
        } > "$_env"
        chmod 600 "$_env"
    else
        # Docker 旧版(QPKG 同名升级)遗留清理:FCB_ 前缀假线配置(前缀改名列车漏网)
        # 与 compose/nginx 专属的死配置行(镜像钉版/数据目录映射/绑定地址/体积上限),
        # 原生模式均不消费;用户显式配置(PB_SERVER_PORT/PB_ADMIN_PASSWORD/…)一律不动
        sed -i.bak \
            -e '/^FCB_API_PORT=/d' -e '/^FCB_DATA_DIR=/d' -e '/^FCB_IMAGE_TAG=/d' \
            -e '/^PB_IMAGE_TAG=/d' -e '/^PB_DATA_DIR=/d' \
            -e '/^PB_API_BIND=/d' -e '/^PB_MAX_BODY_SIZE=/d' -e '/^TZ=/d' \
            "$_env" && rm -f "${_env}.bak"
    fi

    "$WRITE_LOG" "PigeonBox ${QPKG_VER:-} installed(native); data at ${_appdir}" 4
}

PKG_PRE_REMOVE="{ ${SYS_QPKG_DIR}/pigeonbox.sh remove >/dev/null 2>&1 || true; }"
PKG_MAIN_REMOVE="{ true; }"
PKG_POST_REMOVE="{ ${WRITE_LOG} \"PigeonBox uninstalled; data kept at <default volume>/pigeonbox (delete manually if unwanted)\" 4; }"
