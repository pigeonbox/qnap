# QPKG 安装/升级/卸载钩子(由 qinstall.sh source;卸载三钩为字符串代码块,
# 被嵌入生成的 .uninstall.sh 执行,引用不到本文件变量——但本文件顶层的
# 变量在 source 时即展开为字面量,故卸载钩里见到的已是具体路径)。
#
# QDK 打包布局:shared/ 内容被 rsync 平铺到包根(rsync shared/. → build 根),
# env.example 安装后位于 ${SYS_QPKG_DIR}/env.example(勿加 shared/ 前缀——
# 旧版 Docker 包曾因该路径错觉引用 ${SYS_QPKG_DIR}/shared/env.example,真机必挂)。

# FCB_GETCFG/FCB_WRITE_LOG 仅供测试注入 mock(QTS 的 qinstall 运行环境不会设置)
GETCFG="${FCB_GETCFG:-/sbin/getcfg}"
WRITE_LOG="${FCB_WRITE_LOG:-/sbin/write_log}"
DEF_SHARE="${FCB_DEF_SHARE_INFO:-/etc/config/def_share.info}"

pkg_pre_install() {
    # 装完即启:qinstall.sh 按此变量决定安装完成后是否调用服务脚本 start
    SYS_QPKG_SERVICE_ENABLED="TRUE"

    # ── 安装包完整性前置检查(2026-10-22 真机事故固化)────────────────────
    # QDK 的包头脚本用 dd 从安装包自身切出 data.tar.gz 再解包;若安装包本身
    # 被截断(下载中断),切出来的 tar 流也是断的,解包会在写**最后一个文件**时
    # 断流 ⇒ 产出「看起来装上了、实则二进制被截断」的半拉子安装(本次:p2pcweb
    # 9994402→6218752 字节,而 p2pc/pigeonbox 校验和**完全正常**;症状是 p2pcweb
    # 段错误 + 看门狗每 30s 重拉的崩溃循环,安装期没有任何环节报过错)。
    #
    # 本钩子跑在**解包之前**(QDK 顺序:stop_service → pkg_pre_install →
    # extract_data),所以在这里校验 tar 流完整性 ⇒ 截断包当场中止安装,
    # **不会把用户已有的安装覆盖成半拉子**(失败时旧文件原封不动,只需重下包)。
    #
    # 判据用 `tar -tzf` 列表:2026-10-22 QNAP 真机实测 —— 完整包 exit 0、
    # **尾部多余字节也 exit 0**(包头脚本在 python 缺失时不截尾,会多出 832 字节
    # padding,不能因此误判)、截断包 exit 2 ⇒ 只有真断流才会拦。
    _payload="${SYS_EXTRACT_DIR}/data.tar.gz"
    if [ -f "$_payload" ] && command -v tar >/dev/null 2>&1; then
        if ! tar -tzf "$_payload" >/dev/null 2>&1; then
            "$WRITE_LOG" "PigeonBox 安装中止：安装包不完整（data.tar.gz 校验失败，疑似下载中断）——请重新下载完整安装包后再安装（已装版本未被覆盖）" 2
            echo "Installation Abort."
            exit 1
        fi
    fi

    # 升级时清掉上一版的前端产物(QDK 原地升级只覆盖、不删除旧文件)。
    # 为什么要清:vite 产物文件名带内容哈希,新版文件名必然不同 ⇒ 旧 chunk
    # 会与新 chunk **共存**在 www/assets/。运行时不可达(入口 index.html 指向
    # 新 index-*.js),但:
    #   ① 安装目录凭空多出上一版的死资源(实测 2.1.0→3.0.0 残留 530KB);
    #   ② 旧 chunk 里**还带着已退役功能的代码**(Wave B' 删掉的直传控制台
    #      及其 /admin/p2p/status|tasks|send|recv|publish 调用)——发布目录里
    #      留着退役功能的实现,与「破坏性拆除」的语义不符。
    # 时机安全:qinstall.sh 在 stop_service 之后、解包(extract_data)之前调用
    # 本钩子,此时服务已停;业务数据(SQLite/上传文件/JWT 密钥)在卷根
    # <volume>/pigeonbox/,**不在 www 下**,不受影响。
    rm -rf "${SYS_QPKG_DIR}/www" 2>/dev/null || true
}

pkg_post_install() {
    # 构建机 uid 残留防护:QTS 以 root 执行服务脚本与二进制,包内文件统一归零
    # (构建 uid 若属 NAS 真实用户,可改写 root 执行的脚本,提权风险)。
    # 尽力而为:非 root 环境(本地/CI mock 测试)静默跳过;真机 qinstall 以 root 执行必成。
    chown -R 0:0 "${SYS_QPKG_DIR}" 2>/dev/null || true

    _base=$("$GETCFG" SHARE_DEF defVolMP -f "$DEF_SHARE" 2>/dev/null)
    [ -n "$_base" ] || _base="/share/CACHEDEV1_DATA"
    _appdir="${_base}/pigeonbox"
    # 业务数据(SQLite 库/上传文件/JWT 密钥)在卷根,卸载升级均保留
    mkdir -p "${_appdir}/data"

    _env="${_appdir}/.env"
    if [ ! -f "$_env" ]; then
        {
            grep -vE '^PB_SERVER_PORT=' "${SYS_QPKG_DIR}/env.example"
            printf 'PB_SERVER_PORT=%s\n' "12345"
        } > "$_env"
        chmod 600 "$_env"
    else
        # Docker 旧版(QPKG 同名升级)遗留清理:FCB_ 前缀假线配置(前缀改名列车漏网)
        # 与 compose/nginx 专属的死配置行(镜像钉版/数据目录映射/绑定地址/体积上限),
        # 原生模式均不消费;用户显式配置(PB_SERVER_PORT/PB_ADMIN_PASSWORD/…)一律不动
        sed -i.bak \
            -e '/^FCB_API_PORT=/d' -e '/^FCB_DATA_DIR=/d' -e '/^FCB_IMAGE_TAG=/d' \
            -e '/^PB_IMAGE_TAG=/d' -e '/^PB_DATA_DIR=/d' \
            -e '/^PB_API_BIND=/d' -e '/^PB_MAX_BODY_SIZE=/d' -e '/^TZ=/d' \
            "$_env" && rm -f "${_env}.bak"
    fi

    # ── 安装完整性自检(2026-10-22 真机事故固化)────────────────────────
    # QDK 的 dd|tar 解包在写**最后一个文件**时可能断流(安装包被截断/传输中断),
    # 产出「看起来装上了、实则二进制被截断」的半拉子安装——本次事故:
    # p2pcweb 被截到 62%(9994402→6218752 字节),而 p2pc/pigeonbox 两个二进制
    # 校验和**完全正常**,症状却是 p2pcweb 段错误(exit 139)+ 看门狗每 30s 重拉
    # 的崩溃循环。安装期没有任何环节报过错(只留一句 "Installation Abort.")。
    # 包内带 bin/SHA256SUMS(构建期产出),这里逐个核对:不符即**中止安装**并写
    # 响亮日志,让用户看到明确失败,而不是几天后的一段段错误。
    _sums="${SYS_QPKG_DIR}/bin/SHA256SUMS"
    if [ -f "$_sums" ] && command -v sha256sum >/dev/null 2>&1; then
        _bad=""
        while read -r _sum _name; do
            [ -n "${_sum:-}" ] || continue
            case "$_sum" in \#*) continue ;; esac
            _f="${SYS_QPKG_DIR}/bin/${_name#./}"
            if [ ! -f "$_f" ]; then
                _bad="${_bad} ${_name}(缺失)"
                continue
            fi
            _act=$(sha256sum "$_f" 2>/dev/null | cut -d' ' -f1)
            [ "$_act" = "$_sum" ] || _bad="${_bad} ${_name}(校验不符)"
        done < "$_sums"
        if [ -n "$_bad" ]; then
            "$WRITE_LOG" "PigeonBox 安装失败：bin/ 完整性校验不通过${_bad} —— 安装包可能不完整(下载中断)，请重新下载完整安装包后再安装" 2
            echo "Installation Abort."
            exit 1
        fi
    fi

    "$WRITE_LOG" "PigeonBox ${QPKG_VER:-} installed(native); data at ${_appdir}" 4
}

PKG_PRE_REMOVE="{ ${SYS_QPKG_DIR}/pigeonbox.sh remove >/dev/null 2>&1 || true; }"
PKG_MAIN_REMOVE="{ true; }"
PKG_POST_REMOVE="{ ${WRITE_LOG} \"PigeonBox uninstalled; data kept at <default volume>/pigeonbox (delete manually if unwanted)\" 4; }"
