# PigeonBox QNAP 原生应用配置(安装包自动生成于 <默认卷>/pigeonbox/.env;手工修改后
# 在 App Center 停用再启用应用(或重启 NAS)生效)

# ── 常用 ─────────────────────────────────────────────────────────
# 服务端口(App Center「打开」图标链接会自动跟随;改后需放行 NAS 防火墙)
PB_SERVER_PORT=12345
# 管理员密码(**首装必填**:本部署生产门禁开启,留空 = 服务拒绝启动——安全默认,
# 防 admin/admin123 弱口令上线)。改密码:填新值并 `touch <应用目录>/.admin_reset`
# 后重启应用,重置成功后本行自动清空(应用目录/.admin_reset.log 有审计记录)
PB_ADMIN_PASSWORD=

# ── 站点行为 ─────────────────────────────────────────────────────
# 对外完整地址(有域名/HTTPS 反代时填,如 https://files.example.com,分享链接会用它;
# 留空 = 按请求来源动态推断)
PB_SERVER_BASE_URL=
# 开放注册(NAS 场景默认关闭、管理员建号;个人自用建议保持 false)
PB_USER_ALLOW_REGISTRATION=false
# 可信代理 CIDR(逗号分隔;套 HTTPS 网关/反代时必填,否则限流按代理 IP 计数)
PB_TRUSTED_PROXIES=

# ── 高级 ─────────────────────────────────────────────────────────
# JWT 密钥(留空 = 数据目录自动生成持久化(.jwt_secret);显式设置则轮换后旧会话全部失效)
PB_JWT_SECRET=
# Redis(默认单机内存模式:免 Redis 全功能,取件码映射重启丢失;NAS 上启用需自备实例)
PB_REDIS_HOST=
